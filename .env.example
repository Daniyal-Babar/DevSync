# DevSync Environment Configuration

# Database (PostgreSQL)
POSTGRES_USER=devsync
POSTGRES_PASSWORD=devsync
POSTGRES_DB=devsync
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devsync:devsync@localhost:5432/devsync

# Security / JWT
JWT_SECRET_KEY=change-this-in-production-to-a-super-secret-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
WORKSPACES_ROOT=./data/workspaces

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
